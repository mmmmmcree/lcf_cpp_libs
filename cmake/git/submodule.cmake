cmake_minimum_required(VERSION 3.28)

# Explicit Git operations only; ordinary configure/build never changes repository state.
get_filename_component(default_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED ROOT)
    set(ROOT "${default_root}")
endif()
file(REAL_PATH "${ROOT}" ROOT)
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" rev-parse --show-toplevel
    RESULT_VARIABLE result OUTPUT_VARIABLE git_root ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "ROOT must be a Git working tree: ${ROOT}\n${error}")
endif()
file(REAL_PATH "${git_root}" git_root)
if(NOT git_root STREQUAL ROOT)
    message(FATAL_ERROR "ROOT must be the repository root: ${git_root}")
endif()
if(NOT DEFINED ACTION OR NOT ACTION MATCHES "^(add|init|status)$")
    message(FATAL_ERROR "ACTION must be add, init or status")
endif()
set(command submodule)
if(ACTION STREQUAL "add")
    if(NOT DEFINED URL OR URL STREQUAL "" OR URL MATCHES "^-")
        message(FATAL_ERROR "add requires URL pointing to an existing repository with a commit")
    endif()
    if(NOT DEFINED PATH OR NOT PATH MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "add requires a direct-child library PATH, for example utilities")
    endif()
    if(PATH MATCHES "^(cmake|examples|lib_project_template|build|async_pre_rebuild)$")
        message(FATAL_ERROR "PATH is reserved by the workspace: ${PATH}")
    endif()
    if(EXISTS "${ROOT}/${PATH}")
        # Accept an independent generated repository only after its owner has committed it.
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}/${PATH}" rev-parse --show-toplevel
            RESULT_VARIABLE result OUTPUT_VARIABLE child_root ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Existing PATH must be its own Git repository: ${PATH}")
        endif()
        file(REAL_PATH "${ROOT}/${PATH}" child_path)
        file(REAL_PATH "${child_root}" child_root)
        if(NOT child_root STREQUAL child_path)
            message(FATAL_ERROR "Existing PATH is not an independent Git repository: ${PATH}")
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${child_path}" rev-parse --verify HEAD
            RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Commit the new library before registering it as a submodule")
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${child_path}" status --porcelain
            RESULT_VARIABLE result OUTPUT_VARIABLE dirty ERROR_VARIABLE error)
        if(NOT result EQUAL 0 OR NOT dirty STREQUAL "")
            message(FATAL_ERROR "Commit or stash library changes before registering the submodule")
        endif()
    endif()
    list(APPEND command add -- "${URL}" "${PATH}")
elseif(ACTION STREQUAL "init")
    list(APPEND command update --init --recursive)
else()
    list(APPEND command status --recursive)
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" ${command}
    RESULT_VARIABLE result COMMAND_ECHO STDOUT)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Git submodule ${ACTION} failed (${result})")
endif()
if(ACTION STREQUAL "add")
    message(STATUS "Submodule registered; review staged .gitmodules/gitlink and commit in the parent when ready")
endif()
