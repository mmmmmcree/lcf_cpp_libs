cmake_minimum_required(VERSION 3.28)

if(NOT DEFINED NAME OR NOT NAME MATCHES "^[a-z][a-z0-9]*(_[a-z0-9]+)*$")
    message(FATAL_ERROR "NAME must be a lowercase C++ identifier, for example utilities or shader_core")
endif()
set(reserved alignas alignof and and_eq asm auto bitand bitor bool break case catch char char8_t
    char16_t char32_t class compl concept const consteval constexpr constinit const_cast continue
    co_await co_return co_yield decltype default delete do double dynamic_cast else enum explicit
    export extern false float for friend goto if inline int long mutable namespace new noexcept not
    not_eq nullptr operator or or_eq private protected public register reinterpret_cast requires
    return short signed sizeof static static_assert static_cast struct switch template this
    thread_local throw true try typedef typeid typename union unsigned using virtual void volatile
    wchar_t while xor xor_eq)
if(NAME IN_LIST reserved)
    message(FATAL_ERROR "NAME is a reserved C++ keyword: ${NAME}")
endif()
set(cmake_reserved all clean help install package test edit_cache rebuild_cache)
if(NAME IN_LIST cmake_reserved)
    message(FATAL_ERROR "NAME conflicts with a CMake build target: ${NAME}")
endif()
if(DEFINED TYPE)
    message(FATAL_ERROR "Use HEADER_ONLY=ON for header-only; callers select BUILD_SHARED_LIBS for compiled libraries")
endif()
foreach(option HEADER_ONLY WITH_DEPS)
    if(NOT DEFINED ${option})
        set(${option} OFF)
    elseif(NOT "${${option}}" MATCHES "^(ON|OFF|TRUE|FALSE|0|1)$")
        message(FATAL_ERROR "${option} must be ON or OFF")
    endif()
endforeach()
get_filename_component(workspace "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(DEFINED DEST AND DEFINED DESTINATION)
    message(FATAL_ERROR "Use DEST or DESTINATION, not both")
elseif(DEFINED DESTINATION)
    set(DEST "${DESTINATION}")
elseif(NOT DEFINED DEST)
    set(DEST "${workspace}/${NAME}")
endif()
if(DEST STREQUAL "")
    message(FATAL_ERROR "DEST must not be empty")
endif()
get_filename_component(DEST "${DEST}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
if(EXISTS "${DEST}" AND NOT IS_DIRECTORY "${DEST}")
    message(FATAL_ERROR "Destination is not a directory: ${DEST}")
endif()
set(template "${workspace}/lib_project_template")
if(NOT EXISTS "${template}/common/CMakeLists.txt")
    message(FATAL_ERROR "Missing library template: ${template}")
endif()
string(TOUPPER "${NAME}" upper_name)
set(OPTION_PREFIX LCF_${upper_name})
string(REPLACE "_" ";" words "${NAME}")
set(PACKAGE LCF)
foreach(word IN LISTS words)
    if(word STREQUAL "")
        continue()
    endif()
    string(SUBSTRING "${word}" 0 1 first)
    string(TOUPPER "${first}" first)
    string(SUBSTRING "${word}" 1 -1 rest)
    string(APPEND PACKAGE "${first}${rest}")
endforeach()
set(layers common)
set(source_files "")
if(HEADER_ONLY)
    list(APPEND layers header-only)
else()
    list(APPEND layers compiled)
    set(source_files src/${NAME}.cpp)
endif()
set(dependency_include "")
set(dependency_readme "Regular third-party dependency tools were omitted. Development test framework tools are isolated in tests/.")
set(dependency_readme_zh "未包含常规第三方依赖工具；开发测试框架工具独立放在 tests/ 中。")
if(WITH_DEPS)
    list(APPEND layers dependencies)
    set(dependency_include [=[include("${CMAKE_CURRENT_LIST_DIR}/dependencies/resolve.cmake")]=])
    set(dependency_readme "Regular dependencies are declared in deps.json. Entries support scope PUBLIC / PRIVATE / INTERFACE and optional string/script conditions. Existing targets and packages are reused; missing header-only dependencies are staged at build time. Compiled dependencies require a supplied target/package.")
    set(dependency_readme_zh "常规依赖在 deps.json 中声明。条目支持 PUBLIC / PRIVATE / INTERFACE 作用域，以及可选的字符串／脚本条件。优先复用已有目标和包；缺少的纯头文件依赖在构建时暂存。编译型依赖需要提供已有目标或包。")
endif()
# Resolve every output and check for conflicts before creating any files.
set(template_inputs)
set(template_outputs)
foreach(layer IN LISTS layers)
    file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${template}/${layer}"
        "${template}/${layer}/*")
    foreach(path IN LISTS files)
        string(REPLACE "__LIB_NAME__" "${NAME}" output "${path}")
        string(REGEX REPLACE "[.]tpl$" "" output "${output}")
        list(APPEND template_inputs "${template}/${layer}/${path}")
        list(APPEND template_outputs "${DEST}/${output}")
    endforeach()
endforeach()

foreach(input output IN ZIP_LISTS template_inputs template_outputs)
    get_filename_component(parent "${output}" DIRECTORY)
    while(NOT parent STREQUAL DEST)
        if(EXISTS "${parent}" AND NOT IS_DIRECTORY "${parent}")
            message(FATAL_ERROR "Output parent is not a directory; no files were changed: ${parent}")
        endif()
        get_filename_component(parent "${parent}" DIRECTORY)
    endwhile()
    if(IS_DIRECTORY "${output}" OR IS_SYMLINK "${output}")
        message(FATAL_ERROR "Output conflicts with an existing path; no files were changed: ${output}")
    endif()
    if(EXISTS "${output}")
        file(READ "${input}" expected)
        if(input MATCHES "[.]tpl$")
            string(CONFIGURE "${expected}" expected @ONLY)
        endif()
        file(READ "${output}" actual)
        string(REPLACE "\r\n" "\n" expected "${expected}")
        string(REPLACE "\r\n" "\n" actual "${actual}")
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Output conflicts with an existing file; no files were changed: ${output}")
        endif()
    endif()
endforeach()

foreach(input output IN ZIP_LISTS template_inputs template_outputs)
    if(EXISTS "${output}")
        continue()
    endif()
    if(input MATCHES "[.]tpl$")
        configure_file("${input}" "${output}" @ONLY)
    else()
        configure_file("${input}" "${output}" COPYONLY)
    endif()
endforeach()
message(STATUS "Created ${NAME}: ${DEST}")
message(STATUS "HEADER_ONLY=${HEADER_ONLY}; WITH_DEPS=${WITH_DEPS}; package=${PACKAGE}")
message(STATUS "Next: cmake -S \"${DEST}\" -B \"${DEST}/build/local\"")
